   "source": [
    "# =====================================================================\n",
    "# 【参数配置区】—— 临时改连接/默认库/查询参数，只改这一个 cell 即可\n",
    "# =====================================================================\n",
    "\n",
    "# ---------- 0) 配置源选择（双轨，二选一运行） ----------\n",
    "#   True  : 读取 hainandxm.cnf（密码/主机端口统一维护，已 gitignore，推荐默认）\n",
    "#   False : 完全不用 cnf，直接用下面 DB_CONFIG 字典（适合想一切在 notebook 里改的场景）\n",
    "USE_CNF_CONFIG = True\n",
    "\n",
    "# ---------- 1-a) USE_CNF_CONFIG=True 时的覆盖层（留空 = 用 cnf 默认值） ----------\n",
    "#   对应 cnf 默认值：host=localhost  port=3308  user=root  password=******\n",
    "#   hainandxm 分组库=hainandxm（正堂） / ct_dxm 分组库=ct_dxm（昌泰）\n",
    "CONNECT_OVERRIDE = {\n",
    "    # 'host':       'localhost',\n",
    "    # 'port':       3308,\n",
    "    # 'user':       'root',\n",
    "    # 'password':   '******',   # ⚠️ 改密码请去 hainandxm.cnf；这里仅做临时切换\n",
    "    # 'database':   'ct_dxm',   # 填了会把 DEFAULT_GROUP 对应的库也覆盖，慎用\n",
    "}\n",
    "\n",
    "# ---------- 1-b) USE_CNF_CONFIG=False 时直接读这个字典（完全不用 cnf） ----------\n",
    "#   host/port/user/password 是通用连接；DATABASES 里 key 就是 group 名。\n",
    "DB_CONFIG = {\n",
    "    'host':       'localhost',\n",
    "    'port':       3308,\n",
    "    'user':       'root',\n",
    "    'password':   '',    # ⚠️ 纯 notebook 模式需要把密码填到这里（cnf 不存在/不读）\n",
    "    'DATABASES': {\n",
    "        'hainandxm': 'hainandxm',   # group=hainandxm → 正堂库\n",
    "        'ct_dxm':    'ct_dxm',      # group=ct_dxm    → 昌泰库\n",
    "    },\n",
    "}\n",
    "\n",
    "# ---------- 2) 默认库 group（每次调用 q() 不传 group 时生效） ----------\n",
    "# 'ct_dxm' = 昌泰-度小满 / 'hainandxm' = 正堂-度小满\n",
    "DEFAULT_GROUP = 'ct_dxm'\n",
    "\n",
    "# ---------- 3) 常用查询参数（SQL 里用 :名 引用） ----------\n",
    "START_ID   = 656189       # 还款明细起始 id（用于昌泰增量筛查）\n",
    "LOAN_ID_START = 76500     # 昌泰-度小满放款 id 区间起始（含）\n",
    "LOAN_ID_END   = 81000     # 昌泰-度小满放款 id 区间终止（不含）\n",
    "RECON_YEAR_MONTH = '2026-04'   # 正堂对账月份\n",
    "CT_RECON_YEAR_MONTH = '2026-03' # 昌泰对账月份\n",
    "\n",
    "# ---------- 4) 基础目录（USE_CNF_CONFIG=True 时用于定位 cnf） ----------\n",
    "from pathlib import Path\n",
    "PROJECT_ROOT = Path(r'e:\\project\\req')\n",
    "CNF_PATH     = PROJECT_ROOT / 'hainandxm.cnf'\n",
    "DXM_DIR      = PROJECT_ROOT / 'DXM'\n",
    "\n",
    "print('=== [参数配置区] 已加载 ===')\n",
    "print(f'  使用配置源     :', 'hainandxm.cnf + CONNECT_OVERRIDE（推荐）' if USE_CNF_CONFIG else 'DB_CONFIG 字典（纯 Notebook 模式）')\n",
    "print(f'  DEFAULT_GROUP  : {DEFAULT_GROUP}')\n",
    "print(f'  START_ID       : {START_ID}')\n",
    "print(f'  LOAN_ID_RANGE  : [{LOAN_ID_START}, {LOAN_ID_END})')\n",
    "if USE_CNF_CONFIG:\n",
    "    print(f'  cnf_path       : {CNF_PATH} (存在={CNF_PATH.exists()})')\n",
    "    if CONNECT_OVERRIDE:\n",
    "        for k, v in CONNECT_OVERRIDE.items():\n",
    "            print(f'  override: {k} = {\"***\" if k==\"password\" else v}')\n",
    "else:\n",
    "    print(f'  host/port/user : {DB_CONFIG[\"host\"]}:{DB_CONFIG[\"port\"]} / {DB_CONFIG[\"user\"]}')\n",
    "    print(f'  databases      : {DB_CONFIG[\"DATABASES\"]}')\n"
   ]
