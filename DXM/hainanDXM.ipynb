   "cell_type": "code",
   "execution_count": null,
   "id": "init",
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# 【初始化】—— 加载 cnf、合并覆盖参数、定义 q()、注册 %%sql magic\n",
    "# =====================================================================\n",
    "import configparser\n",
    "\n",
    "import pandas as pd\n",
    "import pymysql\n",
    "\n",
    "# ---------- 读取 hainandxm.cnf ----------\n",
    "_cfg = configparser.ConfigParser()\n",
    "assert _cfg.read(CNF_PATH, encoding='utf-8'), f'找不到配置文件 {CNF_PATH}'\n",
    "\n",
    "\n",
    "def _resolve_base_conn_args(group: str) -> dict:\n",
    "    \"\"\"把 cnf 通用段 + group 段合并成 pymysql.connect 的 kwargs，再叠 CONNECT_OVERRIDE\"\"\"\n",
    "    d = {\n",
    "        'host':     _cfg.get('client', 'host'),\n",
    "        'port':     _cfg.getint('client', 'port'),\n",
    "        'user':     _cfg.get('client', 'user'),\n",
    "        'password': _cfg.get('client', 'password'),\n",
    "        'database': _cfg.get(f'client_{group}', 'database'),\n",
    "        'charset':  'utf8mb4',\n",
    "        'cursorclass': pymysql.cursors.DictCursor,\n",
    "    }\n",
    "    # 显式覆盖：CONNECT_OVERRIDE 里填了的都覆盖\n",
    "    for k, v in CONNECT_OVERRIDE.items():\n",
    "        d[k] = v\n",
    "    return d\n",
    "\n",
    "\n",
    "def get_conn(group: str = DEFAULT_GROUP) -> pymysql.Connection:\n",
    "    \"\"\"返回 pymysql 连接。group: 'hainandxm'=正堂库 / 'ct_dxm'=昌泰库\"\"\"\n",
    "    return pymysql.connect(**_resolve_base_conn_args(group))\n",
    "\n",
    "\n",
    "def q(\n",
    "    sql: str,\n",
    "    params: dict | list | tuple | None = None,\n",
    "    group: str = DEFAULT_GROUP,\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    执行 SQL 并返回 DataFrame。\n",
    "\n",
    "    参数绑定规则（避免 SQL 拼接注入）：\n",
    "      * params 传 dict 时：SQL 中用 `:name` / `%(name)s` / `%(name)s` 占位 👉 dict 参数\n",
    "      * params 传 list/tuple 时：SQL 中用 `%s` 占位 👉 按顺序绑定\n",
    "    示例：\n",
    "      df = q('select * from ln_repay_info where id > :start_id limit :n;',\n",
    "             params={'start_id': 656189, 'n': 10})\n",
    "      df = q('select * from ln_loan_info where id >= %s and id < %s;', [76500, 81000], group='ct_dxm')\n",
    "    \"\"\"\n",
    "    conn = get_conn(group)\n",
    "    try:\n",
    "        # pymysql 原生仅支持 `%(name)s` / `%s`；若用户写了 `:name` 风格统一转换成 `%(name)s`\n",
    "        bound_sql = sql\n",
    "        if params is None:\n",
    "            bound_params = None\n",
    "        elif isinstance(params, dict):\n",
    "            import re\n",
    "            # `:name` 只在 `:name` 前面不是 `::`（PostgreSQL cast）、不是字母数字下划线时替换\n",
    "            bound_sql = re.sub(r'(?<!:):([A-Za-z_][A-Za-z0-9_]*)', r'%(\1)s', sql)\n",
    "            bound_params = params\n",
    "        else:\n",
    "            bound_params = params\n",
    "        with conn.cursor() as cur:\n",
    "            cur.execute(bound_sql, bound_params)\n",
    "            rows = cur.fetchall()\n",
    "        return pd.DataFrame(rows)\n",
    "    finally:\n",
    "        conn.close()\n",
    "\n",
    "\n",
    "# ---------- 注册 %%sql magic（让裸 SQL 写在 cell 里成为可能） ----------\n",
    "%load_ext sql\n",
    "%config SqlMagic.autopandas = True     # %%sql 查询直接返回 DataFrame\n",
    "%config SqlMagic.displaylimit = 50    # 默认前 50 行，防大结果刷屏\n",
    "\n",
    "# 构造 ipython-sql 用的 SQLAlchemy URL（参数走 cnf + CONNECT_OVERRIDE）\n",
    "from urllib.parse import quote_plus\n",
    "\n",
    "\n",
    "def _engine_url(group: str = DEFAULT_GROUP) -> str:\n",
    "    c = _resolve_base_conn_args(group)\n",
    "    return (\n",
    "        f\"mysql+pymysql://{c['user']}:{quote_plus(str(c['password']))}\"\n",
    "        f\"@{c['host']}:{c['port']}/{c['database']}?charset=utf8mb4\"\n",
    "    )\n",
    "\n",
    "\n",
    "def connect_magic(group: str = DEFAULT_GROUP):\n",
    "    \"\"\"重新把 %%sql magic 的连接切到指定 group。示例：`connect_magic('hainandxm')`\"\"\"\n",
    "    url = _engine_url(group)\n",
    "    %sql $url\n",
    "    print(f'%%sql magic 已切换到库: {group}')\n",
    "\n",
    "\n",
    "connect_magic(DEFAULT_GROUP)\n",
    "\n",
    "# ---------- 连通性自检（两库各查 apply_base_info 行数） ----------\n",
    "print()\n",
    "print('===== 连通性自检 =====')\n",
    "for g in ('hainandxm', 'ct_dxm'):\n",
    "    n = q('select count(*) as cnt from apply_base_info', group=g)['cnt'][0]\n",
    "    print(f'{g:<10} OK, apply_base_info {n} 行')\n"
   ]
  },
